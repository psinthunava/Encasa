generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum Role {
  ADMIN
  MEMBER
}

enum SplitMethod {
  EQUAL
  PERCENTAGE
  FIXED
  CUSTOM
}

enum ExpenseStatus {
  ACTIVE
  VOID
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SettlementStatus {
  OPEN
  SETTLED
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
}

// --- Household structure ---

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  families            Family[]
  categories          Category[]
  expenses            Expense[]
  receipts            Receipt[]
  settlements         Settlement[]
  recurringTemplates  RecurringExpenseTemplate[]
  auditLogs           AuditLog[]
  vendors             Vendor[]
  bills               Bill[]
}

// Saved vendor/store names for autocomplete on expense entry. Free-text on
// Expense.vendor stays independent of this list, so deleting a saved vendor
// never touches historical expenses.
model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  name        String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId])
}

model Family {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  name        String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household        Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members           Member[]
  expensesPaid      Expense[]                @relation("ExpensePaidByFamily")
  expenseSplits     ExpenseSplit[]
  settlementLines   SettlementLine[]
  subcategorySplitConfigs SubcategorySplitConfig[]
  billPayments      BillPayment[]            @relation("BillPaymentPaidByFamily")

  @@index([householdId])
}

// Member.id mirrors the Supabase `auth.users.id` (uuid) for that person.
// Supabase Auth owns credentials; this table only stores app-level profile/role data.
model Member {
  id        String   @id @db.Uuid
  familyId  String   @db.Uuid
  email     String   @unique
  name      String
  role      Role     @default(MEMBER)
  canAddExpenses Boolean @default(true)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family           Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expensesCreated  Expense[]         @relation("ExpenseCreatedBy")
  receiptsUploaded Receipt[]         @relation("ReceiptUploadedBy")
  auditLogs        AuditLog[]
  billsCreated     Bill[]            @relation("BillCreatedBy")
  billPaymentsCreated BillPayment[]  @relation("BillPaymentCreatedBy")
  billAttachmentsUploaded BillAttachment[] @relation("BillAttachmentUploadedBy")

  @@index([familyId])
}

// --- Categories ---

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  name        String
  sortOrder   Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  expenses      Expense[]
  recurringTemplates RecurringExpenseTemplate[]
  bills         Bill[]

  @@index([householdId])
}

model Subcategory {
  id          String      @id @default(uuid()) @db.Uuid
  categoryId  String      @db.Uuid
  name        String
  sortOrder   Int         @default(0)
  archived    Boolean     @default(false)
  // Default split applied to every expense filed under this subcategory, until an admin changes it here.
  splitMethod SplitMethod @default(EQUAL)
  // Default "recurring" flag applied to every expense filed under this subcategory.
  isRecurring Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  recurringTemplates RecurringExpenseTemplate[]
  splitConfigs SubcategorySplitConfig[]
  bills     Bill[]

  @@index([categoryId])
}

// One row per family per subcategory, only used when the subcategory's
// splitMethod is not EQUAL. Meaning of inputValue depends on splitMethod:
// PERCENTAGE -> percent (0-100, must sum to 100 across the subcategory's families)
// CUSTOM     -> relative share/weight (e.g. occupant count), any positive number
// FIXED      -> fixed dollar reference amount; null means "gets the remaining balance"
model SubcategorySplitConfig {
  id            String   @id @default(uuid()) @db.Uuid
  subcategoryId String   @db.Uuid
  familyId      String   @db.Uuid
  inputValue    Decimal? @db.Decimal(12, 4)

  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, familyId])
  @@index([familyId])
}

// --- Expenses ---

model Expense {
  id            String        @id @default(uuid()) @db.Uuid
  householdId   String        @db.Uuid
  date          DateTime      @db.Date
  categoryId    String        @db.Uuid
  subcategoryId String?       @db.Uuid
  description   String
  vendor        String?
  amount        Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidByFamilyId String       @db.Uuid
  notes         String?
  tags          String[]      @default([])
  isRecurring   Boolean       @default(false)
  splitMethod   SplitMethod   @default(EQUAL)
  status        ExpenseStatus @default(ACTIVE)
  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])
  paidByFamily Family      @relation("ExpensePaidByFamily", fields: [paidByFamilyId], references: [id])
  createdBy   Member       @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  splits      ExpenseSplit[]
  receipts    Receipt[]
  billPayment BillPayment?

  @@index([householdId, date])
  @@index([categoryId])
  @@index([paidByFamilyId])
}

// One row per family per expense, capturing how that expense was divided.
model ExpenseSplit {
  id         String   @id @default(uuid()) @db.Uuid
  expenseId  String   @db.Uuid
  familyId   String   @db.Uuid
  // Meaning depends on the expense's splitMethod:
  // EQUAL/CUSTOM -> unused input, PERCENTAGE -> percent (0-100), FIXED -> fixed dollar amount
  inputValue Decimal? @db.Decimal(12, 4)
  amountOwed Decimal  @db.Decimal(12, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([expenseId, familyId])
  @@index([familyId])
}

// --- Bills ---

// A Bill tracks a vendor invoice from arrival to payoff. Each recorded
// BillPayment immediately generates its own Expense (paid by whichever
// family made that payment, split per this bill's category/subcategory
// rule) -- so a bill paid off in several installments, possibly by
// different families, produces several correctly-attributed Expense rows.
// status flips PARTIAL once any payment lands, PAID once cumulative
// payments reach amountDue, at which point the bill drops out of the
// open-bills list.
model Bill {
  id            String     @id @default(uuid()) @db.Uuid
  householdId   String     @db.Uuid
  categoryId    String     @db.Uuid
  subcategoryId String?    @db.Uuid
  vendor        String
  invoiceId     String
  description   String?
  statementDate DateTime   @db.Date
  dueDate       DateTime   @db.Date
  amountDue     Decimal    @db.Decimal(12, 2)
  notes         String?
  status        BillStatus @default(UNPAID)
  createdById   String     @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?     @relation(fields: [subcategoryId], references: [id])
  createdBy   Member           @relation("BillCreatedBy", fields: [createdById], references: [id])
  payments    BillPayment[]
  attachments BillAttachment[]

  @@index([householdId, status])
  @@index([householdId, dueDate])
}

// One row per payment made toward a Bill. expenseId points at the Expense
// this specific payment generated -- deleting the parent Bill cascades to
// BillPayment rows but never to the Expense rows they point at, so
// financial history survives even if the bill tracking record is removed.
model BillPayment {
  id             String   @id @default(uuid()) @db.Uuid
  billId         String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  paidDate       DateTime @db.Date
  paidByFamilyId String   @db.Uuid
  notes          String?
  expenseId      String   @unique @db.Uuid
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  bill         Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  paidByFamily Family  @relation("BillPaymentPaidByFamily", fields: [paidByFamilyId], references: [id])
  expense      Expense @relation(fields: [expenseId], references: [id])
  createdBy    Member  @relation("BillPaymentCreatedBy", fields: [createdById], references: [id])

  @@index([billId])
}

// A scanned/photographed/attached file for a bill (Supabase Storage,
// private bucket -- storagePath is resolved to a signed URL on render).
model BillAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  billId       String   @db.Uuid
  storagePath  String
  fileName     String
  mimeType     String
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  bill       Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  uploadedBy Member @relation("BillAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([billId])
}

// --- Receipts ---

model Receipt {
  id           String   @id @default(uuid()) @db.Uuid
  householdId  String   @db.Uuid
  expenseId    String   @db.Uuid
  storagePath  String
  fileName     String
  mimeType     String
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expense    Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy Member    @relation("ReceiptUploadedBy", fields: [uploadedById], references: [id])

  @@index([expenseId])
}

// --- Recurring expense templates ---

model RecurringExpenseTemplate {
  id            String             @id @default(uuid()) @db.Uuid
  householdId   String             @db.Uuid
  categoryId    String             @db.Uuid
  subcategoryId String?            @db.Uuid
  description   String
  vendor        String?
  amount        Decimal            @db.Decimal(12, 2)
  splitMethod   SplitMethod        @default(EQUAL)
  frequency     RecurringFrequency
  nextRunDate   DateTime           @db.Date
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@index([householdId])
}

// --- Settlements ---

model Settlement {
  id          String           @id @default(uuid()) @db.Uuid
  householdId String           @db.Uuid
  periodStart DateTime         @db.Date
  periodEnd   DateTime         @db.Date
  status      SettlementStatus @default(OPEN)
  generatedAt DateTime         @default(now())
  settledAt   DateTime?

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  lines     SettlementLine[]

  @@unique([householdId, periodStart, periodEnd])
}

model SettlementLine {
  id           String  @id @default(uuid()) @db.Uuid
  settlementId String  @db.Uuid
  familyId     String  @db.Uuid
  totalPaid    Decimal @db.Decimal(12, 2)
  totalOwed    Decimal @db.Decimal(12, 2)
  balance      Decimal @db.Decimal(12, 2) // positive = owed money back, negative = owes money

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([settlementId, familyId])
}

// --- Audit log ---

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  memberId    String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    Member?   @relation(fields: [memberId], references: [id])

  @@index([householdId, createdAt])
}
